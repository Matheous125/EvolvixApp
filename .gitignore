*.jks
*.keystore
keystore.properties
app/google-services.json

# ============================================================
# ml-training/ (Python ML pipeline — Phase 6.5)
# ============================================================
# Folder itself is tracked, but generated data and the virtualenv are not.
ml-training/.venv/
ml-training/data/*
!ml-training/data/.gitkeep
ml-training/**/__pycache__/
ml-training/**/*.pyc

