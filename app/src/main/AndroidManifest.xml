<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 7.1 — POST_NOTIFICATIONS is runtime-only on Android 13+ (API 33). On 29..32 it has no effect. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager schedules wake the device only briefly; no SCHEDULE_EXACT_ALARM needed because we use inexact delays. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Evolvix"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Evolvix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 7.1 — receives Done / Snooze action taps from habit reminder notifications.
             ACTION_SKIP is intentionally absent: the Skip button routes directly to
             SkipReasonPickerActivity via PendingIntent.getActivity() (Phase 9.5 / 9.6.3). -->
        <receiver
            android:name=".notifications.HabitActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.evolvix.action.DONE" />
                <action android:name="com.example.evolvix.action.SNOOZE" />
            </intent-filter>
        </receiver>

        <!-- Phase 9.5 / 9.6.3 — Transparent Activity hosting the skip-reason ModalBottomSheet.
             Launched directly by PendingIntent.getActivity() from HabitReminderWorker when the
             user taps the "Skip" notification action. No MainActivity involvement.
             - excludeFromRecents: dialog must not appear as a separate card in the recents switcher.
             - launchMode=singleTop: prevents stacking multiple instances if tapped quickly.
             - taskAffinity="": isolates the Activity from the main app's back stack. -->
        <activity
            android:name=".notifications.SkipReasonPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Evolvix.Dialog"
            android:windowSoftInputMode="adjustResize" />

        <!-- Phase 7.2 v2 — receives the deleteIntent fired when the user swipes away
             the daily-summary notification without tapping it. Used to count dismissals
             and auto-disable the summary after 7 consecutive ignores. -->
        <receiver
            android:name=".notifications.SummaryDismissReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.evolvix.SUMMARY_DISMISS" />
            </intent-filter>
        </receiver>

    </application>

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

</manifest>